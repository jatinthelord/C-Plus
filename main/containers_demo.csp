#include <array.h>
#include <list.h>
#include <map.h>
#include <memory.h>
#include <new.h>
#include <set.h>
#include <csxStudio.h>
#include <cpstream>

int main() {
    cp::map<int, int> scores{{1, 40}, {2, 60}};
    cp::set<int> tags{4, 4, 8};
    cp::list<int> history{1, 2};
    cp::append(history, 3);
    cp::array<int, 3> weights{2, 3, 5};
    auto owned = cp::make_owner<int>(scores[1] + scores[2]);
    cp::arena temporary;
    int *arena_value = temporary.create<int>(weights[0] * weights[2]);
    csx::studio::project project{"containers-demo"};
    printc("score=%d tags=%d history=%d arena=%d target=%s\n"
           *owned, (int)tags.size(), (int)history.size(), *arena_value,
           csx::studio::target_flag(project.build_target).data());
    return 0;
}
