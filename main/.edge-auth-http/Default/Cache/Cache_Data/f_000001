:root {
  --ink: #17212b; --muted: #647382; --line: #dce3e9; --soft: #f4f7f9;
  --surface: #fff; --navy: #111820; --blue: #1793d1; --blue-dark: #0877b0;
  --green: #21875b; --shadow: 0 18px 50px rgba(20,40,58,.09); --radius: 10px; --shell: 1180px;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; overflow-x: hidden; color: var(--ink); background: var(--surface); font: 15px/1.6 "Segoe UI Variable Text","Segoe UI",Inter,ui-sans-serif,system-ui,sans-serif; -webkit-font-smoothing: antialiased; }
a { color: var(--blue-dark); text-decoration: none; }
a:hover { color: var(--blue); }
img { max-width: 100%; }
code,pre { font-family: "Cascadia Code","SFMono-Regular",Consolas,monospace; }
code { font-size: .92em; }
pre { margin: 0; padding: 18px 20px; overflow: auto; color: #dbe7ef; background: #111820; border: 1px solid #293643; border-radius: 8px; line-height: 1.65; }
button,input,select { font: inherit; }
button,.button { cursor: pointer; }
:focus-visible { outline: 3px solid rgba(23,147,209,.35); outline-offset: 3px; }
.shell { width: min(calc(100% - 40px),var(--shell)); margin-inline: auto; }
.skip-link { position: fixed; left: 16px; top: -60px; z-index: 100; padding: 10px 14px; color: #fff; background: var(--blue); border-radius: 6px; }
.skip-link:focus { top: 12px; }

.site-header { position: sticky; top: 0; z-index: 50; color: #fff; background: rgba(17,24,32,.96); border-bottom: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(12px); }
.nav { min-height: 68px; display: flex; align-items: center; gap: 24px; }
.brand { display: inline-flex; align-items: center; gap: 11px; color: #fff; margin-right: auto; }
.brand:hover { color: #fff; }
.brand-mark { width: 39px; height: 39px; display: inline-flex; flex: 0 0 39px; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg,#27a7e6,var(--blue-dark)); border-radius: 7px; font-size: 17px; font-weight: 850; letter-spacing: -.06em; box-shadow: inset 0 1px 0 rgba(255,255,255,.2); }
.brand-mark span { color: #bce9ff; }
.brand strong,.brand small { display: block; line-height: 1.05; }
.brand strong { font-size: 16px; letter-spacing: .02em; }
.brand small { margin-top: 4px; color: #92a2af; font-size: 10px; text-transform: uppercase; letter-spacing: .16em; }
.nav-links { display: flex; align-items: center; gap: 4px; }
.nav-links a { padding: 9px 10px; color: #bcc8d1; border-radius: 6px; font-size: 13px; font-weight: 650; }
.nav-links a:hover,.nav-links a[aria-current="page"] { color: #fff; background: rgba(255,255,255,.07); }
.nav-links .nav-download { margin-left: 6px; color: #fff; background: var(--blue); }
.nav-links .nav-download:hover { background: #23a3e3; }
.menu-button { display: none; padding: 8px 11px; color: #fff; background: transparent; border: 1px solid #4a5965; border-radius: 6px; }

.hero { position: relative; overflow: hidden; color: var(--ink); background: #fff; border-bottom: 1px solid var(--line); }
.hero::before { content: ""; position: absolute; inset: 0; opacity: .55; background-image: linear-gradient(rgba(23,147,209,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(23,147,209,.045) 1px,transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(90deg,transparent,#000); pointer-events: none; }
.hero::after { content: ""; position: absolute; width: 620px; height: 620px; right: -260px; top: -310px; background: radial-gradient(circle,rgba(23,147,209,.13),transparent 68%); pointer-events: none; }
.hero-grid { position: relative; z-index: 1; min-height: 500px; display: grid; grid-template-columns: minmax(0,1.18fr) minmax(320px,.72fr); align-items: center; gap: 72px; padding-block: 68px; }
.hero-grid > * { min-width: 0; }
.eyebrow { margin: 0 0 12px; color: var(--blue); font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
.hero .eyebrow { color: var(--blue-dark); }
.hero h1 { max-width: 690px; margin: 0; font-size: clamp(42px,5.2vw,68px); line-height: 1.04; letter-spacing: -.045em; text-wrap: balance; }
.hero h1 span { color: #67c8f8; }
.hero-lead { max-width: 650px; margin: 24px 0 0; color: var(--muted); font-size: 18px; line-height: 1.7; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 30px; }
.button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 17px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); background: #fff; font-weight: 750; }
.button:hover { color: var(--blue-dark); border-color: #a9cfe3; }
.button.primary { color: #fff; background: var(--blue); border-color: var(--blue); }
.button.primary:hover { color: #fff; background: #23a3e3; border-color: #23a3e3; }
.button.ghost { color: var(--ink); background: rgba(255,255,255,.8); border-color: #aebbc5; }
.button.ghost:hover { color: var(--blue-dark); border-color: var(--blue); }
.button [data-current-version] { margin-left: .28em; }
.hero-code { min-width: 0; max-width: 100%; padding: 21px; background: rgba(7,13,18,.92); border: 1px solid #334653; border-radius: 9px; box-shadow: 0 28px 65px rgba(0,0,0,.28); }
.terminal-bar { display: flex; gap: 6px; margin-bottom: 18px; }
.terminal-bar i { width: 9px; height: 9px; display: block; border-radius: 50%; background: #45535e; }
.terminal-bar i:first-child { background: #f0685e; }
.terminal-bar i:nth-child(2) { background: #e6ba52; }
.terminal-bar i:nth-child(3) { background: #56bb78; }
.hero-code pre { padding: 0; border: 0; background: transparent; }
.token-blue { color: #67c8f8; }
.token-green { color: #7ed69c; }
.token-muted { color: #71808c; }

.stats { margin-top: -1px; background: var(--soft); border-bottom: 1px solid var(--line); }
.stats-grid { display: grid; grid-template-columns: repeat(4,1fr); }
.stat { padding: 24px 26px; border-right: 1px solid var(--line); }
.stat:first-child { border-left: 1px solid var(--line); }
.stat strong { display: block; font-size: 19px; letter-spacing: -.02em; }
.stat span { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
.section { padding-block: 78px; }
.section.tint { background: var(--soft); border-block: 1px solid var(--line); }
.section-heading { max-width: 720px; margin-bottom: 30px; }
.section-heading h2 { margin: 0 0 10px; font-size: clamp(28px,4vw,42px); line-height: 1.15; letter-spacing: -.035em; }
.section-heading p { margin: 0; color: var(--muted); font-size: 17px; }
.feature-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
.feature-card,.news-card { position: relative; padding: 27px; background: #fff; border: 1px solid var(--line); border-radius: 6px; transition: border-color .18s,box-shadow .18s,transform .18s; }
.feature-card::before { content: ""; position: absolute; left: -1px; right: -1px; top: -1px; height: 3px; background: var(--blue); border-radius: 6px 6px 0 0; transform: scaleX(0); transform-origin: left; transition: transform .18s ease; }
.feature-card:hover::before { transform: scaleX(1); }
.feature-card:hover,.news-card:hover { border-color: #b9d9e9; box-shadow: var(--shadow); transform: translateY(-2px); }
.feature-icon { width: auto; height: auto; display: block; margin-bottom: 21px; color: #90a0ab; background: transparent; border-radius: 0; font: 750 11px/1 "Cascadia Code",Consolas,monospace; letter-spacing: .12em; }
.feature-card h3,.news-card h3 { margin: 0 0 8px; font-size: 18px; }
.feature-card p,.news-card p { margin: 0; color: var(--muted); }
.feature-card a { display: inline-block; margin-top: 18px; font-weight: 750; }
.news-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 18px; }
.news-card time { color: var(--muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
.news-card h3 { margin-top: 10px; }
.quick-start { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: center; }
.quick-start h2 { margin: 0 0 12px; font-size: 36px; letter-spacing: -.03em; }
.quick-start p { color: var(--muted); }

.page { min-height: calc(100vh - 170px); padding-block: 36px 70px; }
.breadcrumb { margin-bottom: 26px; color: var(--muted); font-size: 13px; }
.page-title { max-width: 800px; margin-bottom: 34px; }
.page-title h1 { margin: 0 0 12px; font-size: clamp(34px,5vw,52px); line-height: 1.08; letter-spacing: -.04em; }
.page-title p:not(.eyebrow) { margin: 0; color: var(--muted); font-size: 17px; }
.box { padding: 26px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 8px 24px rgba(20,40,58,.035); }
.box + .box { margin-top: 20px; }
.box h1,.box h2,.box h3 { margin-top: 0; line-height: 1.25; }
.box h2 { font-size: 21px; }
.filter-bar,fieldset { display: flex; flex-wrap: wrap; align-items: end; gap: 14px; margin: 0; padding: 20px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--soft); }
fieldset label { flex: 1 1 190px; color: var(--muted); font-size: 12px; font-weight: 750; text-transform: uppercase; letter-spacing: .06em; }
input,select { width: 100%; min-height: 42px; margin-top: 6px; padding: 8px 11px; color: var(--ink); background: #fff; border: 1px solid #bdc9d2; border-radius: 6px; }
form button,.hash button,.detail-artifact button { min-height: 42px; padding: 7px 15px; color: #fff; background: var(--blue); border: 1px solid var(--blue); border-radius: 6px; font-weight: 750; }
.table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }
table.results { width: 100%; border-collapse: collapse; background: #fff; font-size: 13px; }
.results th { padding: 12px 14px; color: #53616c; background: var(--soft); border-bottom: 1px solid var(--line); text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .07em; white-space: nowrap; }
.results td { padding: 13px 14px; border-bottom: 1px solid #e8edf1; white-space: nowrap; }
.results tr:last-child td { border-bottom: 0; }
.results tr:hover td { background: #f8fbfd; }
.results .wrap { min-width: 280px; white-space: normal; }
.pkg-name a { font-weight: 800; }
.pkglist-stats { color: var(--muted); }
.pkglist-nav { display: none; }

.library-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
.library-card { min-height: 180px; padding: 23px; color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: var(--radius); transition: .18s ease; }
.library-card:hover { color: var(--ink); border-color: #a9d2e6; box-shadow: var(--shadow); transform: translateY(-2px); }
.library-card code { color: var(--blue-dark); font-size: 14px; font-weight: 800; }
.library-card p { color: var(--muted); }
.library-card span { color: var(--blue-dark); font-size: 13px; font-weight: 750; }
.install-note { margin-top: 24px; }
.install-note .button { margin-right: 12px; }
.platform-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
.tab { padding: 8px 13px; color: #53616c; background: var(--soft); border: 1px solid var(--line); border-radius: 99px; font-weight: 700; }
.tab.active,.tab:hover { color: #fff; background: var(--blue); border-color: var(--blue); }
.download-list { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
.download-item { display: grid; grid-template-columns: 1.15fr .35fr 1.4fr auto; gap: 20px; align-items: center; padding: 18px 20px; border-bottom: 1px solid var(--line); }
.download-item:last-child { border-bottom: 0; }
.artifact-name { font-weight: 800; }
.artifact-meta { color: var(--muted); font-size: 12px; }
.hash { min-width: 0; display: flex; align-items: center; gap: 8px; }
.hash code { display: block; min-width: 0; overflow: hidden; color: #4c5b67; text-overflow: ellipsis; white-space: nowrap; }
.hash button,.detail-artifact button { min-height: 32px; padding: 4px 9px; color: var(--blue-dark); background: #fff; }
.download-link { padding: 8px 12px; color: #fff; background: var(--blue); border-radius: 6px; font-weight: 750; white-space: nowrap; }
.download-link:hover { color: #fff; background: var(--blue-dark); }
.verification { margin-top: 24px; }

.timeline { position: relative; margin: 0 0 26px 9px; padding-left: 30px; border-left: 2px solid #cbd8e0; }
.release-entry { position: relative; padding: 5px 0 34px; }
.release-entry::before { content: ""; position: absolute; left: -38px; top: 12px; width: 12px; height: 12px; background: var(--blue); border: 4px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px var(--blue); }
.release-entry h3 { margin: 0 0 3px; font-size: 21px; }
.release-entry time { color: var(--muted); font-size: 12px; }
.release-entry p { max-width: 720px; color: var(--muted); }
.badge,.package-state { display: inline-block; padding: 3px 8px; color: var(--green); background: #e7f6ee; border-radius: 99px; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; vertical-align: middle; }
.package-detail > header { display: flex; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--line); }
.package-detail > header h1 { margin-bottom: 5px; font-size: 32px; }
.package-detail > header h1 span { color: var(--muted); font-size: 16px; }
.detail-columns { display: grid; grid-template-columns: 1.1fr .9fr; gap: 42px; padding-block: 24px; }
.detail-columns dl { margin: 0; }
.detail-columns dl div { display: grid; grid-template-columns: 140px 1fr; gap: 15px; padding: 8px 0; border-bottom: 1px solid #edf1f4; }
.detail-columns dt { color: var(--muted); }
.detail-columns dd { margin: 0; font-weight: 700; }
.detail-section { padding-top: 23px; border-top: 1px solid var(--line); }
.detail-section pre { max-height: 300px; }
.detail-artifact { display: grid; grid-template-columns: .8fr 1.4fr auto; gap: 12px; align-items: center; padding: 11px 0; border-top: 1px solid var(--line); }
.detail-artifact code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.benchmark-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-block: 20px; }
.benchmark-grid .box { margin: 0; }
.benchmark-meta { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; }
.benchmark-meta div { padding: 14px; background: var(--soft); border-radius: 7px; }
.benchmark-meta dt { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; }
.benchmark-meta dd { margin: 5px 0 0; font-weight: 750; }
.benchmark-warning { padding-left: 13px; border-left: 3px solid #e5ac43; color: var(--muted); }
.source-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
.source-card { display: block; padding: 25px; color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 6px; }
.source-card:hover { color: var(--ink); border-color: #a9d2e6; box-shadow: var(--shadow); }
.source-card h2 { margin: 0 0 8px; font-size: 18px; }
.source-card p { margin: 0 0 15px; color: var(--muted); }
.source-card span { color: var(--blue-dark); font-weight: 750; }
.error-page { min-height: 70vh; display: grid; place-items: center; text-align: center; }
.error-code { color: var(--blue); font-size: 13px; font-weight: 850; letter-spacing: .15em; }
.error-page h1 { margin: 8px 0; font-size: clamp(40px,7vw,68px); letter-spacing: -.05em; }
.error-page p { color: var(--muted); }
.footer { color: #aab8c2; background: var(--navy); border-top: 1px solid #293540; }
.footer-grid { min-height: 150px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 30px; }
.footer strong { display: block; color: #fff; }
.footer p { margin: 6px 0 0; }
.footer-links { display: flex; flex-wrap: wrap; gap: 18px; }
.footer a { color: #c6d1d8; }
.footer a:hover { color: #fff; }
.copyright { padding-block: 24px; text-align: center; }

@media (max-width: 920px) {
  .menu-button { display: block; }
  .nav-links { position: absolute; display: none; top: 61px; left: 20px; right: 20px; padding: 10px; background: #17212b; border: 1px solid #3a4853; border-radius: 8px; box-shadow: var(--shadow); }
  .nav-links.open { display: grid; }
  .nav-links .nav-download { margin: 0; }
  .hero-grid { grid-template-columns: 1fr; min-height: auto; gap: 45px; }
  .feature-grid,.library-grid,.source-grid { grid-template-columns: repeat(2,1fr); }
  .download-item { grid-template-columns: 1fr auto; }
  .hash { grid-column: 1/-1; }
  .quick-start { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .shell { width: min(calc(100% - 28px),var(--shell)); }
  .hero-grid { padding-block: 55px; }
  .hero h1 { max-width: 100%; font-size: clamp(38px,11vw,47px); overflow-wrap: anywhere; }
  .hero-lead { font-size: 16px; }
  .hero-code { padding: 17px; }
  .hero-code pre { font-size: 12px; }
  .hero-actions .button { flex: 1 1 145px; }
  .stats-grid { grid-template-columns: repeat(2,1fr); }
  .stat:nth-child(3) { border-left: 1px solid var(--line); }
  .feature-grid,.library-grid,.news-grid,.source-grid,.benchmark-grid,.detail-columns { grid-template-columns: 1fr; }
  .section { padding-block: 56px; }
  .page { padding-top: 26px; }
  .page-title h1 { font-size: 38px; }
  .download-item { grid-template-columns: 1fr; gap: 8px; }
  .hash { grid-column: auto; }
  .download-link { text-align: center; }
  .benchmark-meta { grid-template-columns: 1fr 1fr; }
  .detail-artifact { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr; padding-block: 34px; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *,*::before,*::after { transition: none !important; } }
